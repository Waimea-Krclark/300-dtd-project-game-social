{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block title %}- Sign Up{% endblock %}

{% block content %}
    <section class="form full">
        <h2>Sign Up</h2>
        <form method="post" action="/signup" enctype="multipart/form-data">
            <div class="list">
                <input name="username" type="text" placeholder="Username..." required>
                <input name="password" type="password" placeholder="Password..." required>
            </div>

            <h3>Optional:</h3>
            <label>
                Upload or drop profile image...
                <input
                    name="image"
                    type="file"
                    accept="image/png, image/jpeg, image/gif"
                >
            </label>
            <br>
            <br>
            <label>
                <textarea name="bio" rows="6" placeholder="Bio..."></textarea>
            </label>
            <br>
            <div id="buttons">
                <button>Create Account</button>
                <a href="/">Cancel</a>
            </div>
            <p>Got an account? <a href="/user/login" class="default">Log in</a> instead.</p>
        </form>
    </section>
{% endblock %}

