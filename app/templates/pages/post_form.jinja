{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block title %}- New Post{% endblock %}

{% block content %}
    <section class="form full">
        {% if session.user.is_dev == 1 %}
            <h2>New Developer Post</h2>
        {% else %}
            <h2>New Discussion for {{game_name.name}}</h2>
        {% endif %}
        
        <form method="post" action="/post/create{{ '/' ~ game_id if game_id and game_id != None else '' }}" enctype="multipart/form-data">
            <input name="title" type="text" placeholder="Post Title" required>

            {% if session.user.is_dev == 1 %}
                <div class="options">
                    <label>
                        Type
                        <select name="type" required>
                            <option disabled value="" selected hidden>Choose an option</option>
                            <option value="news">News</option>
                            <option value="announcement">Announcement</option>
                            <option value="major update">Major Update</option>
                            <option value="patch">Patch</option>
                        </select>
                    </label>

                    <label>
                        Game
                        <select name="game" required>
                            <option disabled value="" {{ 'selected' if game_id == None }} hidden>Choose an option</option>
                            {% for game in games %}
                                <option value="{{game.id}}"  {{ 'selected' if game_id == game.id }}>{{game.name}}</option>
                            {%endfor%}
                        </select>
                    </label>
                </div>
            {% endif %}

            <input type="hidden" name="content" id="content">
            <input type="file" name="image_files" id="image_files" multiple hidden>
            <trix-editor input="content" class="trix-editor" placeholder="Content..." required></trix-editor>
            
            <div id="buttons">
                <button>Post</button>
                <a href="/developer">Cancel</a>
            </div>
        </form>
    </section>
{% endblock %}