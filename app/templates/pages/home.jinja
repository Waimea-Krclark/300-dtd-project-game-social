{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}
    
    <label class="switch">
        <input type="checkbox" id="toggle" onchange="toggleSwitch(this)" {% if session.get("show_games") %}checked{% endif %}>
        <span class="slider"></span>
        <p id="switchText">Games</p>
    </label>
   
     <section id="search">
        <form action="/search" method="get">
            <label>
                Search for...
                <input type="search" name="q" value="{{search_term}}">
            </label>
            <label>
            Sort By:
                <select name="sortby">
                    <option value="0">Alphabetical</option>
                    <option value="1">Newest</option>
                    <option value="2">Oldest</option>
                </select>
            </label>
            <button>Search</button>
        </form>
        
    </section>

    <section id="posts">
        {% for post in posts %}
            {% if allgames | selectattr("developer_id", "equalto", post.user_id) | list %}
                <div class="post">
                    <header>
                        <h3>{{ post.title }}</h3>
                    </header>
                    <p>{{ post.username }}</p>
                    <p>{{ post.type.upper() }}</p>
                    <p>{{ post.timestamp }}</p>
                    <p>{{ posts | selectattr("parent_id", "equalto", post.id) | list | length }} Comments</p>
                    <p>{{ likes | selectattr("post_id", "equalto", post.id) | list | length }} Likes</p>
                    <p class="truncate-paragraph">{{ post.content }}</p>
                    
                </div>
            {% endif %}
        {% else %}
            <p>No Notes!</p>
        {% endfor %}
    </section>

    <section id="games">
        {% for game in games %}
            <div class="game">
                <header>
                    <h3>{{ game.name }}</h3>
                </header>
                <p>{{ game.username | paragraphs }}</p>
                <p>{{ followed_games | selectattr("game_id", "equalto", game.id) | list | length }} following</p>
            </div>
        {% else %}
            <p>No Notes!</p>
        {% endfor %}
    </section>
{% endblock %}

