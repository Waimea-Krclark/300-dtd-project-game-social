{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block title %}- Developer{% endblock %}

{% block content %}
    <header id="editing-header">
        <h2>{{session.user.username | upper}}</h2>
        <h1>DEVELOPER DASHBOARD</h1>
    </header>
    <section class="section-heading">
        <h2>Your Games</h2>
        <a href="/game/new">New Game</a>
    </section>

    <section id="games">
        {% for game in games %}
            <div class="game" onclick="window.location.href= '/game/{{game.id}}'" style="background-image:linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.5)), url('/static/uploads/{{ game.image_name }}');">
                <header>
                    <h3>{{ game.name | upper}}</h3>
                </header>
                <div class="details">
                    <a href="/user/profile/{{game.developer_id}}">{{ game.username | paragraphs }}</a>
                    {% if session.logged_in and session.user.is_dev == 1 and session.user.user_id == game.developer_id %}
                        <a href="/game/{{game.id}}/edit" class="interaction"><img src="/static/images/edit-icon.svg" class="icon" alt="Edit Icon">Edit</a>
                    {% endif %}
                    <footer>
                        <div>
                            <img src="/static/images/follower.svg" alt='Following Icon' class="icon">
                            <p>{{ followed_pairs | selectattr("1", "equalto", game.id) | list | length }} following</p>
                        </div>
                    </footer>
                </div>
            </div>
        {% else %}
                <p>No games!</p>
        {% endfor %}
        
    </section>
    <section class="section-heading">
        <h2>Your Posts:</h2>
        <a href="/post/new">New Post</a>
    </section>
    <section class="form">
        <form action="/developer/search" method="get">
            <input type="search" name="q" value="{{search_term}}" placeholder="Search...">
            <label>
            Sort By:
                <select name="sortby">
                    <option value="1" {{ 'selected' if sort_term == '1' }}>Newest</option>
                    <option value="0" {{ 'selected' if sort_term == '0' }}>Alphabetical</option>
                    <option value="2" {{ 'selected' if sort_term == '2' }}>Oldest</option>
                </select>
            </label>
            <button>SEARCH</button>
        </form>
    </section>
    <section id="posts">
        {% for post in posts %}
            <div class="post" onclick="window.location.href= '/post/{{post.id}}'">
                    <header>
                        <h3>{{ post.title | upper}}</h3>
                        <div class="details">
                            <a href="/user/profile/{{post.user_id}}">{{ post.username }}</a>
                            <a href="/game/{{post.game_id}}">{{ post.name }}</a>
                            <p>{{ post.type.upper() }}</p>
                            <p>{{ post.timestamp | format_date}}</p>

                            {# selectattr is 1, as since liked_pairs is a tuple, jinja needs to reference the index, rather than the name, so 1 is the post_id #}
                            {% if session.logged_in and (session.user.user_id, post.id) in liked_pairs%}
                                <a href="/post/{{post.id}}/unlike"><img src="/static/images/heart-filled-icon.svg" class="icon" alt="Liked Icon"> {{ liked_pairs | selectattr("1", "equalto", post.id) | list | length }}</a>
                            {% elif session.logged_in %}
                                <a href="/post/{{post.id}}/like"><img src="/static/images/heart-icon.svg" class="icon" alt="like Icon"> {{ liked_pairs | selectattr("1", "equalto", post.id) | list | length }}</a>
                            {% else%}
                                <p><img src="/static/images/heart-icon.svg" class="icon" alt="like Icon">{{ liked_pairs | selectattr("1", "equalto", post.id) | list | length }}</p>
                            {% endif %}              

                            <p><img src="/static/images/comment.svg" class="icon" alt="Comments Icon">{{ comments | selectattr("parent_id", "equalto", post.id) | list | length }}</p>     
                        </div>
                    </header>
                
                    {% if session.logged_in and session.user.user_id == post.user_id %}
                        <a href="/post/{{post.id}}/edit" class="interaction"><img src="/static/images/edit-icon.svg" class="icon" alt="Edit Icon">Edit</a>
                        <a href="/post/{{post.id}}/delete" onclick="return confirm('Are you sure you want to delete the post?);" class="interaction"><img src="/static/images/remove.svg" alt="Remove icon" class="icon">Delete</a>
                    {% endif %}
                    
                    <div class="truncate-paragraph">{{ post.content }}</div>
                    <footer>Read more...</footer>
                </div>
        {% else %}
            <p>No posts!</p>
        {% endfor %}
    </section>

{% endblock %}

