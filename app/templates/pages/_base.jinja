{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="dark">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Checkpoint {% block title %}{% endblock %}</title>

    <link rel="icon" href="/static/images/icon.png">

    <script src="/static/js/utils.js"></script>
    <script src="/static/js/switch.js"></script>
    <script src="/static/js/nav_option.js"></script>
    <script src="/static/js/dyn_form.js"></script>
    <script src="/static/js/trix_uploads.js"></script>
    <script src="/static/js/screenshot_stack.js"></script>

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    {# Trix Implementation (Rich Text Editor) #}
    <link rel="stylesheet" type="text/css" href="https://unpkg.com/trix@2.0.8/dist/trix.css">
    <script src="https://unpkg.com/trix@2.0.8/dist/trix.umd.min.js"></script>

    {# Splide Implementation (Image Carousel) #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4/dist/css/splide.min.css">
    <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4/dist/js/splide.min.js"></script>

    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

    <header>
        <a href="/">
            <img src="/static/images/checkpoint-logo.png" id="web_logo" alt="Web Logo">
        </a>

        <nav>
            {% if back_url %}
                <a href="{{ back_url }}"><img src="/static/images/back-arrow.svg" class="icon" alt="Back Icon"><p>Back</p></a>
            {% else %}
                 <a href="{{ request.referrer or '/' }}"><img src="/static/images/back-arrow.svg" class="icon" alt="Back Icon"><p>Back</p></a>
            {% endif %}
            <a href="/"><img src="/static/images/home-icon.svg" class="icon" alt="Home Icon"><p>Home</p></a>
            <a href="javascript:void(0);" onclick="toggleOptionMenu()"><img src="/static/images/profile-icon.svg" class="icon" alt="Profile Icon"><p>Profile</p></a>
            {% if session.logged_in %} 
                <section class="menu" id="menuDrop">
                    <div id="arrow"></div>
                    <h5>WELCOME: {{session.user.username | upper}}</h5>
                    <a href="/user/profile/{{session.user.user_id}}">Profile</a>
                    {% if session.user.is_dev %}
                        <a href="/developer">Developer</a>
                        <a href="/post/new">New Post</a>
                        <a href="/game/new">New Game</a>
                    {% endif %}
                    <a href="/logout">Logout</a>
                </section>
            {% else %}
                <section class="menu" id="menuDrop">
                    <h5>WELCOME GUEST</h5>
                    <div id="arrow"></div>
                    <a href="/user/login">Sign In</a>
                    <a href="/user/signup">Sign Up</a>
                </section>
            {% endif %}
            
        </nav>
    </header>

    {# Show flash messages from any previous events #}
    {% include "partials/messages.jinja" %}

    <main>
        <div id="page_content">
            {% block content %}
            {% endblock %}
        </div>
    </main>

</body>

</html>

