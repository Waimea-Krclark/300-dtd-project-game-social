{#=====================================================
  Post page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block title %}- {{post.title}}{% endblock %}

{% block content %}
    <header id="post-header">
        <section>
            <div class="details">
                <div>
                    <p>{{ post.type.upper() }}</p>
                    <p>{{ post.timestamp | format_date}}</p>
                </div>
                <a href="/game/{{post.game_id}}">{{ post.name | upper}}</a>
                <a href="/user/profile/{{post.user_id}}">{{post.username}}</a>
            </div>

            <h1 class="{{ 'discussion' if post.type == 'discussion' }}">{{ post.title }}</h1>   
            <div class="post-options">
                <div>
                    {% if session.logged_in and session.user.user_id == post.user_id %}
                        <a href="/post/{{post.id}}/edit" class="interaction"><img src="/static/images/edit-icon.svg" class="icon" alt="Edit Icon">Edit</a>
                        <a href="/post/{{post.id}}/delete" onclick="return confirm('Are you sure you want to delete the post?');" class="interaction"><img src="/static/images/remove.svg" alt="remove Icon" class="icon">Delete</a>
                    {% endif %}                 
                </div>
                <div>
                    {# selectattr is 1, as since liked_pairs is a tuple, jinja needs to reference the index, rather than the name, so 1 is the post_id #}
                    {% if session.logged_in and (session.user.user_id, post.id) in liked_pairs%}
                        <a href="/post/{{post.id}}/unlike"><img src="/static/images/heart-filled-icon.svg" class="icon" alt="Liked Icon"> {{ liked_pairs | selectattr("1", "equalto", post.id) | list | length }}</a>
                    {% elif session.logged_in %}
                        <a href="/post/{{post.id}}/like"><img src="/static/images/heart-icon.svg" class="icon" alt="Like Icon"> {{ liked_pairs | selectattr("1", "equalto", post.id) | list | length }}</a>
                    {% else%}
                        <p><img src="/static/images/heart-icon.svg" class="icon" alt="Like Icon">{{ liked_pairs | selectattr("1", "equalto", post.id) | list | length }}</p>
                    {% endif %}              
                    <p><img src="/static/images/comment.svg" class="icon" alt="Comments Icon">{{ comments | selectattr("parent_id", "equalto", post.id) | list | length }}</p>                    
                </div>

            </div>
        </section>
    </header>
    <div>{{ post.content | clean_trix(2)}}</div>
    <section id="comments">
        <h3>Comments:</h3>
        {% if session.logged_in %}
            <div class="form">
                <form method="post" action="/post/{{post.id}}/comment">
                    <label>
                        <input placeholder="Leave a Comment..." name="comment" type="text" required>
                    </label>
                    <button>Post</button>
                </form>
            </div>
        {% else %}
            <p>Log in to Comment</p>
        {% endif %}
        <div id="posts">
            {% for comment in comments %}
                {% if comment.parent_id == post.id%}
                    <div class="post">
                        <header>
                            <a href="/user/profile/{{comment.user_id}}"><img src="/static/uploads/{{comment.profile_image}}" alt="{{comment.username}}'s profile image" class="profile">{{ comment.username }}</a>
                            {% if session.logged_in and session.user.user_id == comment.user_id %}
                                <a href="/post/{{comment.id}}/delete" onclick="return confirm('Are you sure you want to delete the comment?);" class="interaction"><img src="/static/images/remove.svg" alt="Remove icon" class="icon">Delete</a>
                            {% endif %}
                            <p>{{comment.timestamp  | format_human}}</p>
                        </header>
                        <div>{{comment.content}}</div>
                        <br>
                        <button class="interaction" onclick="toggleReplies(this)">Show replies...</button>

                        <ul class="replies">
                            <div class="options">
                                {% if session.logged_in %}
                                    <form method="post" action="/post/{{comment.id}}/comment" class="form">
                                        <label>
                                            <input placeholder="Leave a Reply..." name="comment" type="text" required>
                                        </label>
                                        <button>Post</button>
                                    </form>
                                {% else %}
                                    <p>Log in to Reply</p>
                                {% endif %}
                            </div>
                            {% set replies = comments | selectattr("parent_id", "equalto", comment.id) | list %}
                            {% for reply in replies recursive %}
                                {% set replies = comments | selectattr("parent_id", "equalto", reply.id) | list %}
                                <li>
                                    <header>
                                        <a href="/user/profile/{{reply.user_id}}"><img src="/static/uploads/{{reply.profile_image}}" alt="{{reply.username}}'s profile image" class="profile"> {{ reply.username }}</a>
                                        {% if session.logged_in and session.user.user_id == reply.user_id %}
                                            <a href="/post/{{reply.id}}/delete" onclick="return confirm('Are you sure you want to delete the comment?);" class="interaction"><img src="/static/images/remove.svg" alt="remove icon" class="icon">Delete</a>
                                        {% endif %}
                                        <p>{{reply.timestamp  | format_human}}</p>
                                    </header>
                                    <p>{{reply.content}}</p>
                                    {% if loop.depth < 5 %}
                                        {% if session.logged_in %}
                                            <form method="post" action="/post/{{reply.id}}/comment" class="form">
                                                <label>
                                                    <input placeholder="Leave a Reply..." name="comment" type="text" required>
                                                </label>

                                                <button>Post</button>
                                            </form>
                                        {% else %}
                                            <p>Log in to Reply</p>
                                        {% endif %}
                                    {% endif %}
                                    {% if replies %}
                                        <ul>
                                            {{ loop(replies) }}
                                        </ul>
    
                                    {% endif %}
                                </li>
                                
                            {% endfor %}
                        </ul>
                    </div>  
                {% endif %}
            {% endfor %}
        </div>
    </section>
    
{% endblock %}

