{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block title %}- New Game{% endblock %}

{% block content %}
    <section class="form full">
         <header id="editing-header">
            <h2>{{session.user.username | upper}}</h2>
            <h1>CREATE GAME PAGE</h1>
        </header>
        <form method="post" action="/game/new" enctype="multipart/form-data">
            <label>
                <input name="title" type="text" placeholder="Title" required>
            </label>
        
            <div class="list" id="store_links">
                <p>Store Links</p>
                <button type="button" onclick="new_link()" id="new_link_button">New Link</button>
                <input name="link" type="text" placeholder="Enter Link" required>
            </div>

            <label>
                <textarea name="description" rows="6" placeholder="Description" required></textarea>
            </label>

            <h3>Hero Image:</h3>
            <label>
                <input
                    name="hero"
                    type="file"
                    accept="image/png, image/jpeg, image/gif"
                >
            </label>
            <h3>Optional Screenshots</h3>
            <p>Select images:</p>
            <label>
                <input
                    name="screenshots"
                    type="file"
                    multiple
                    accept="image/png, image/jpeg, image/gif"
                >
            </label>

            <div id="buttons">
                <button>Create Game</button>
                <a href="/developer">Cancel</a>
            </div>
        </form>
    </section>
{% endblock %}

